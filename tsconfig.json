{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@statewalker/storage": [
        "packages/storage/src"
      ],
      "@statewalker/storage/*": [
        "packages/storage/src/*"
      ],
      "@statewalker/content-store": [
        "packages/content-store/src"
      ],
      "@statewalker/content-store/*": [
        "packages/content-store/src/*"
      ],
      "@statewalker/content-transfer": [
        "packages/content-transfer/src"
      ],
      "@statewalker/content-transfer/*": [
        "packages/content-transfer/src/*"
      ],
      "@statewalker/merge-core": [
        "packages/merge-core/src"
      ],
      "@statewalker/merge-core/*": [
        "packages/merge-core/src/*"
      ],
      "@statewalker/files-sync": [
        "packages/files-sync/src"
      ],
      "@statewalker/files-sync/*": [
        "packages/files-sync/src/*"
      ]
    }
  },
  "include": []
}